# Copy to .env (gitignored) and adjust. infrastructure/container.py loads
# this file automatically via python-dotenv; none of these are required
# to just run the app -- every default below already works offline.

# "1" (default): offline canned adapters, no external services.
# "0": real RAG -- ChromaCorpusRetriever + OpenAIAnswerGenerator.
ITW_ME_FAKE_LLM=1

# Only read when ITW_ME_FAKE_LLM=0.
# Defaults target a local Ollama server (zero cost). To use the real
# OpenAI API instead, set:
#   ITW_ME_LLM_BASE_URL=https://api.openai.com/v1
#   ITW_ME_MODEL=gpt-4o-mini
#   OPENAI_API_KEY=sk-...
ITW_ME_LLM_BASE_URL=http://localhost:11434/v1
ITW_ME_MODEL=llama3.1
OPENAI_API_KEY=ollama
